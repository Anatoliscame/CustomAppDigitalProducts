    &lt;attribute name='sc_productdetailsid'/&gt;
    &lt;attribute name='sc_productdetailsidname'/&gt;

    &lt;attribute name='sc_parentdigitalproductid'/&gt;
    &lt;attribute name='sc_parentdigitalproductidname'/&gt;

    &lt;attribute name='sc_baseprice'/&gt;
    &lt;attribute name='sc_baseprice_base'/&gt;

    &lt;attribute name='sc_description'/&gt;
    &lt;attribute name='sc_requirementsnotesactivation'/&gt;

    &lt;attribute name='sc_statodigitalproduct'/&gt;
    &lt;attribute name='sc_statodigitalproductname'/&gt;

    &lt;attribute name='sc_stockavailable'/&gt;

    &lt;attribute name='sc_typedigitalproduct'/&gt;
    &lt;attribute name='sc_typedigitalproductname'/&gt;

    &lt;attribute name='sc_typeplatform'/&gt;
    &lt;attribute name='sc_typeplatformname'/&gt;

    &lt;attribute name='statuscode'/&gt;
    &lt;attribute name='statuscodename'/&gt;

    &lt;filter type='and'&gt;
      &lt;condition attribute='statecode' operator='eq' value='0' /&gt;
    &lt;/filter&gt;

  &lt;/entity&gt;
&lt;/fetch&gt;</property>
