                  expressionType="Notify"
                  name="SourceEntity"></property>
                <property
                  dataType="System.String"
                  description="FetchXML statement."
                  expressionType="Notify"
                  name="FetchXML">&lt;fetch mapping='logical'&gt;
  &lt;entity name='sc_digitalproduct'&gt;

    &lt;attribute name='sc_digitalproductid'/&gt;
    &lt;attribute name='sc_name'/&gt;
    &lt;attribute name='sc_codice'/&gt;
    &lt;attribute name='sc_key'/&gt;

    &lt;attribute name='sc_accountclientid'/&gt;
