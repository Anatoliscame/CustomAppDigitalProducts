                      name="Expression">[FINDSTRING]([UPPER](#{Package\Import courses\Excel worksheet of X Factor finalists.Outputs[Excel Source Output].Columns[Mentor]}),"CHERYL",1) &gt; 0</property>
                    <property
                      containsID="true"
                      dataType="System.String"
                      description="Specifies the friendly version of the expression. This expression version uses column names."
                      expressionType="Notify"
                      name="FriendlyExpression">FINDSTRING(UPPER(Mentor),"CHERYL",1) &gt; 0</property>
